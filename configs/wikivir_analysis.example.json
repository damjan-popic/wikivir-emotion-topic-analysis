{
  "input": "data/annotated/wikivir-classla.conllu",
  "sloemolex": "data/lexicons/SloEmoLex_v1.tsv",
  "output_dir": "analysis/wikivir",
  "segment_levels": "document,paragraph,window,sentence",
  "window_size": 250,
  "window_step": 125,
  "normalization": "simple",
  "match_on": "lemma,form",
  "lda_unit": "document",
  "lda_topics": 30,
  "lda_grid": "10,20,30,40,50",
  "lda_auto_select": true,
  "run_transformers": true,
  "topic_classifier_model": "cjvt/sloberta-trendi-topics",
  "transformer_unit": "window",
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "embedding_unit": "window",
  "embedding_clusters": 0,
  "export_token_matches": true,
  "make_plots": true,
  "save_models": true,
  "require_embedded_metadata": true
}
